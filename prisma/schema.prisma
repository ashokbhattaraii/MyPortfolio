generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url= env("DATABASE_URL")
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  status    String
  tags      String[]
  image     String?
  author    String? @default("Admin")
  published Boolean  @default(false)
  publishedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
